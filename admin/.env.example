# 管理端 环境变量模板（示例值，非真实配置）
# 由原 .env 生成：所有密钥/账号类取值已清空（含注释中的示例密钥），请填入你自己的值。

# ═══════════════════════════════════════════════════════════════════════
#  管理后台配置（admin/server.py 启动时自动读取）
#
#  · 本文件已被 .gitignore 忽略（规则 `.env` 匹配任意层级），不会进 git
#  · 真实环境变量优先级高于本文件：命令行 `ADMIN_PASSWORD=xxx python3 admin/server.py`
#    会覆盖这里（语义与 config.py 的 _load_dotenv 一致）
#  · 改完需重启后台才生效
#  · 管理员密码、监听地址、端口、数据库路径都在这里设置，不需要再记环境变量
# ═══════════════════════════════════════════════════════════════════════

# ── 登录密码 ───────────────────────────────────────────────────────────
# 留空 → 沿用 data/.admin_password 文件（start-tunnel.sh 维护的那个，当前生效的就是它）
# 填写 → 以本文件为准，忽略 data/.admin_password
# 两处都空 → 免密模式：登录框不出现，谁能访问端口谁就能改库删库
ADMIN_PASSWORD=

# ── 监听地址 ───────────────────────────────────────────────────────────
# 127.0.0.1  只允许本机 + cloudflared 隧道访问（推荐，默认）
# 0.0.0.0    局域网内任何设备都能访问（无密码时等于把数据库交出去）
ADMIN_HOST=127.0.0.1

# ── 监听端口 ───────────────────────────────────────────────────────────
ADMIN_PORT=8899

# ── 数据库文件（可选）──────────────────────────────────────────────────
# 留空 = data/tickets.db（生产库）
# 填入其它路径可用于"查看某个备份"，例如：
#   DB_PATH=data/tickets.db.bak_20260828_guardfix
# ⚠️ 指向别的库时，后台的 SQL 控制台与增删改都会作用到那个库上，改前务必确认。
DB_PATH=
