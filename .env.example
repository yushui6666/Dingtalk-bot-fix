# 钉钉报修工单系统 环境变量模板（示例值，非真实配置）
# 由原 .env 生成：所有密钥/账号类取值已清空（含注释中的示例密钥），请填入你自己的值。

# 云端模型配置（Task 4）
# ⚠️ 本文件含真实密钥，已在 .gitignore 中，不会被提交
#LLM_API_KEY=<redacted>
LLM_API_KEY=
#LLM_BASE_URL=https://api.deepseek.com
LLM_BASE_URL=http://127.0.0.1:19090/v1
#LLM_MODEL=deepseek-v4-flash
LLM_MODEL=glm-5.3-flash
# hy3 不支持 json_object，必须用 json_schema（auto 对非 OpenAI 端点默认 json_object 会 400）
LLM_RESPONSE_FORMAT=json_object
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_ENABLED=true

# 视觉模型配置（图片多模态解析，OpenAI 兼容）
VISION_ENABLED=true
VISION_BASE_URL=http://127.0.0.1:19090/v1
VISION_MODEL=minimax-m3
VISION_PROMPT=请描述这张图片中的内容，重点说明与设备故障/损坏相关的信息。如果看不出故障信息，如实说明。
VISION_API_KEY=

# 响应 SLA 升级配置（2026-08-24 需求 #4）
# 工程总监A userId 已核实：门店 CSV「总工程师userId」（各店群配置 engineering_leader_id 同值，
# 即使不配此变量也会回退到该值）。
RESPONSE_SLA_ENGINEER_ESCALATE_USER_ID=
RESPONSE_SLA_ENGINEER_ESCALATE_NAME=
# 提醒/升级阈值（小时），默认 1h 一级提醒、4h 升级
# RESPONSE_SLA_FIRST_HOURS=1
# RESPONSE_SLA_ESCALATE_HOURS=4

# 思考模式：auto=仅对 DeepSeek 域名显式禁用(默认,省 token 且避免 json_object 偶发空响应)
# LLM_THINKING_MODE=auto

# 响应 SLA 总开关（2026-08-26）：false 时关闭全部 1h 提醒/4h 升级/单聊提醒，不影响其他 SLA
RESPONSE_SLA_ENABLED=false
